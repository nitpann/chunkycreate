# Copy this file to .env.local and fill in your real Razorpay keys.
# .env.local is already in .gitignore — never commit real keys.

# Server-side only — never exposed to the browser.
RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Public — safe to expose to the browser (Standard Checkout needs the
# key id client-side to open the payment modal). The NEXT_PUBLIC_ prefix
# is required for Next.js to bundle it into client code.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_key_id_here
